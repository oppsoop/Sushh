# Copy to .env only on your own machine or configure in your hosting dashboard.
# Never commit real values. See README.md for beginner deployment instructions.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=https://your-service.example.com
DATABASE_URL=postgresql://username:password@db.example.com:5432/worldfriends
DATABASE_SSL=true
DATABASE_SSL_VERIFY=true
# DATABASE_CA_CERT=your_provider_CA_certificate_PEM
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# SMTP URL must use a real account or transactional mail provider.
# Percent-encode the username and password in this URL.
SMTP_URL=smtps://user%40example.com:APP_PASSWORD@smtp.example.com:465
MAIL_FROM=WorldFriends <user@example.com>

# On a host with a persistent disk, set MEDIA_DIR to a folder on that disk.
STORAGE=local
MEDIA_DIR=./data/media
# Alternatively use STORAGE=s3 and configure the S3-compatible fields.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

BETA_MODE=true
BETA_ALLOW_ANY_EMAIL=false
BETA_ALLOWED_EMAILS=
# Optional shared invite codes; use admin/invites for limited-use codes.
BETA_INVITE_CODES=

# Optional: configure in Firebase and never commit the service-account key.
# GOOGLE_CLIENT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# TURN_URLS=turn:your-turn-host:3478?transport=udp,turns:your-turn-host:5349?transport=tcp
# TURN_SHARED_SECRET=
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
