{
  "name": "worldfriends-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WorldFriends backend: auth, realtime chat, media, social graph, calls signaling, push.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "pg": "8.13.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
